{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/api/indexnow",
      "schedule": "40 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/media/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=31536000, immutable"
        }
      ]
    }
  ]
}
